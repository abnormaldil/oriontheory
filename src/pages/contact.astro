---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ContactForms from '~/components/ContactForms.astro';
import { verifiedEmail } from '~/data/site';

const email = verifiedEmail();
---

<BaseLayout
  title="Contact Orion Theory — App Support & Enquiries"
  description="Contact Orion Theory for app support, feedback, privacy questions, or business enquiries."
  path="/contact"
  hideCallout
>
  <PageHero
    title="Get in touch"
    band="ink"
    intro="Need help with an Orion Theory app, want to share feedback, or have a business enquiry? Choose the right topic and contact us."
  />

  <div class="wrap contact-grid">
    <ContactForms />

    <aside class="direct band-cobalt" aria-labelledby="direct-title" data-reveal>
      <h2 id="direct-title" class="title t-2">Email us</h2>
      {
        email ? (
          <>
            <a class="direct-email" href={`mailto:${email}`}>
              {email}
            </a>
            <p class="muted">
              Prefer your own email app? Write to us directly. Please don’t include passwords or
              sensitive personal information.
            </p>
          </>
        ) : (
          <>
            <p class="direct-email">
              <mark class="placeholder">[Verified contact email]</mark>
            </p>
            <p class="muted">
              Our contact address will be published here as soon as the mailbox has been verified.
            </p>
          </>
        )
      }
      <p class="direct-links">
        Looking for answers first? Try <a class="link" href="/support">Support</a>. For privacy
        questions, see the <a class="link" href="/policy">Privacy Policy</a>.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
    .direct {
      position: sticky;
      top: 6.5rem;
    }
  }
  .direct {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }
  .direct h2 {
    color: var(--sun);
  }
  .direct-email {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 750;
    font-size: var(--step-2);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .direct-email :global(mark) {
    font-family: var(--font-text);
    font-size: 1rem;
  }
  .direct-links {
    padding-top: 1rem;
    border-top: 1px solid var(--line-on-dark);
    font-size: var(--step--1);
  }
</style>
