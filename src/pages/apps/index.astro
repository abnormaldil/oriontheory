---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ProductFeature from '~/components/ProductFeature.astro';
import AppsArt from '~/components/AppsArt.astro';
import Star from '~/components/Star.astro';
import { apps, appDirections } from '~/data/products';
---

<BaseLayout
  title="Apps by Orion Theory — Practical & Creative Mobile Apps"
  description="Orion Theory makes practical and creative mobile apps for productivity, organization, creativity, and everyday utility. See released apps and what’s coming."
  path="/apps"
>
  <PageHero
    title="Apps"
    size="t-6"
    band="cobalt"
    intro="Practical and creative mobile tools from Orion Theory — apps that help with focus, organization, making things and the small jobs of everyday life."
  >
    <div slot="art" class="hero-art-apps apps-hover">
      <AppsArt />
    </div>
  </PageHero>

  {
    apps.length > 0 ? (
      <section class="wrap catalogue" aria-label="All apps">
        {apps.map((app, i) => (
          <ProductFeature product={app} heading="h2" flip={i % 2 === 1} />
        ))}
      </section>
    ) : (
      <section class="wrap empty" aria-labelledby="empty-title" data-reveal>
        <h2 id="empty-title" class="display t-4">
          More apps are on the way.
        </h2>
        <div class="empty-body">
          <p class="lede">
            We haven’t released an app yet. When we do, it will appear here with its own page,
            support details, and a verified Google Play link.
          </p>
          <p class="muted">
            Our first release is a game, <a class="link" href="/games/what-flag">What Flag</a>.
          </p>
        </div>
      </section>
    )
  }

  <section class="wrap section-sm directions-sec" aria-labelledby="directions-title">
    <div class="directions-head" data-reveal>
      <h2 id="directions-title" class="display t-3">What we want to make</h2>
      <p class="muted">
        These are the areas we’re interested in, not announced products. Each app will get its own
        page here once it’s real.
      </p>
    </div>
    <ul class="directions">
      {
        appDirections.map((d, i) => (
          <li class="direction" style={`--c:${d.color}`} data-reveal>
            <span class="direction-star" aria-hidden="true" style={`--r:${i * 22}deg`}>
              <Star color="var(--ink)" />
            </span>
            <h3 class="title t-2">{d.name}</h3>
            <p>{d.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap idea" aria-labelledby="idea-title" data-reveal>
    <h2 id="idea-title" class="title t-3">Have an idea for a useful app?</h2>
    <div class="actions">
      <a class="btn btn-cobalt" href="/contact">Tell us <span class="arrow" aria-hidden="true">→</span></a>
      <a class="arrow-link" href="/games">Looking for games? <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-art-apps {
    width: 100%;
  }
  .catalogue {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5);
  }
  .empty {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-3);
  }
  .empty h2 {
    max-width: 12ch;
  }
  .empty-body {
    display: grid;
    gap: var(--space-2);
  }
  @media (min-width: 58rem) {
    .empty {
      grid-template-columns: 6fr 5fr;
      align-items: end;
      gap: var(--space-5);
    }
  }

  .directions-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1.5px solid var(--rule);
  }
  .directions-head p {
    max-width: 50ch;
  }
  @media (min-width: 58rem) {
    .directions-head {
      grid-template-columns: 6fr 5fr;
      align-items: end;
      gap: var(--space-5);
    }
  }
  /* One colour-block strip rather than a grid of identical cards */
  .directions {
    display: grid;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .direction {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    background: var(--c);
    color: var(--ink);
  }
  .direction-star {
    width: 3rem;
    margin-bottom: 1rem;
    transform: rotate(var(--r));
    transition: transform 0.8s var(--spring);
  }
  .direction:hover .direction-star {
    transform: rotate(calc(var(--r) + 90deg)) scale(1.1);
  }
  @media (min-width: 40rem) {
    .directions {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .directions {
      grid-template-columns: repeat(4, 1fr);
    }
    .direction {
      min-height: 19rem;
    }
  }

  .idea {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
  }
  @media (min-width: 58rem) {
    .idea {
      grid-template-columns: 7fr 5fr;
      align-items: center;
    }
  }
</style>
