---
import type { GetStaticPaths } from 'astro';
import ProductPage from '~/components/ProductPage.astro';
import { apps, type Product } from '~/data/products';

// No apps are released yet, so this currently generates no pages.
export const getStaticPaths = (() =>
  apps.map((product) => ({ params: { slug: product.slug }, props: { product } }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<ProductPage product={product} />
