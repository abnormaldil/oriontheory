---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Star from '~/components/Star.astro';
import OrionMark from '~/components/OrionMark.astro';

const rows: { title: string; color: string; html: string }[] = [
  {
    title: 'What we’re here to make',
    color: 'var(--tomato)',
    html: 'We believe a good mobile experience doesn’t need to be complicated. It needs a clear idea, thoughtful execution, and respect for the person using it. We’re building a growing collection of <a class="link" href="/games">games</a> and <a class="link" href="/apps">apps</a> around that belief.',
  },
  {
    title: 'Our first game',
    color: 'var(--sun)',
    html: '<a class="link" href="/games/what-flag">What Flag</a> is our first planned release: a flag-guessing game designed to make world flags fun to explore. It’s in development and not yet available.',
  },
  {
    title: 'How we work',
    color: 'var(--cobalt)',
    html: '<strong>Easy to begin.</strong> Clear interfaces and a welcoming first experience. <strong>Worth returning to.</strong> Thoughtful details make everyday use feel rewarding. <strong>Made with care.</strong> We keep improving our work and listen to useful feedback.',
  },
  {
    title: 'Keep in touch',
    color: 'var(--mint)',
    html: 'For app support, feedback, or business enquiries, contact us through our <a class="link" href="/contact">contact page</a>. Product news goes in the <a class="link" href="/journal">journal</a>.',
  },
];
---

<BaseLayout
  title="About Orion Theory — Independent Apps & Games"
  description="Learn about Orion Theory, an independent publisher creating thoughtful mobile apps and games, starting with What Flag."
  path="/about"
>
  <PageHero
    title="A small studio for curious ideas."
    band="sun"
    intro="Orion Theory is an independent app and game publisher focused on making mobile experiences with clarity, character, and care."
  >
    <div slot="art" class="about-mark mark-hover">
      <OrionMark animate />
    </div>
  </PageHero>

  <div class="wrap about-body">
    {
      rows.map((r) => (
        <section class="row" data-reveal>
          <span class="row-star" aria-hidden="true">
            <Star color={r.color} />
          </span>
          <h2 class="display t-3">{r.title}</h2>
          <p class="row-text" set:html={r.html} />
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .about-mark {
    width: min(100%, 15rem);
    color: var(--ink);
  }
  .about-body {
    padding-block: var(--space-5);
  }
  .row {
    display: grid;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .row:first-child {
    border-top: 1.5px solid var(--rule);
  }
  .row-star {
    width: 3rem;
    transition: transform 0.8s var(--spring);
  }
  .row:hover .row-star {
    transform: rotate(90deg) scale(1.08);
  }
  .row h2 {
    max-width: 14ch;
  }
  .row-text {
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--fg-2);
  }
  .row-text :global(strong) {
    color: var(--fg);
  }
  @media (min-width: 58rem) {
    .row {
      grid-template-columns: 4rem minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }
  }
</style>
