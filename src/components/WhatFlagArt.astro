---
/**
 * What Flag key art, built from the game's own design pack
 * (scripts/import-what-flag-assets.mjs): the app icon's globe background,
 * its explorer character leaning out of the icon frame, and three of the
 * game's 3D props. Flag imagery is used only for What Flag.
 */
import { Image } from 'astro:assets';
import iconBackground from '~/assets/what-flag/icon-background.jpg';
import iconCharacter from '~/assets/what-flag/icon-character.png';
import propCoin from '~/assets/what-flag/prop-coin.png';
import propStar from '~/assets/what-flag/prop-star.png';
import propPin from '~/assets/what-flag/prop-map-pin.png';

interface Props {
  /** Kept for API compatibility with ProductArt. */
  id?: string;
  /** Hide from assistive tech when the artwork repeats nearby content. */
  decorative?: boolean;
  /** Load immediately (above the fold). */
  eager?: boolean;
}
const { decorative = false, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const sizes = '(min-width: 64rem) 30rem, 80vw';
---

<div
  class="wf-art"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'What Flag app icon: a young explorer in a blue cap holding a flag in front of a globe, with a big yellow question mark.'}
  aria-hidden={decorative ? 'true' : undefined}
>
  <div class="wf-tile">
    <Image src={iconBackground} alt="" widths={[360, 640, 900]} sizes={sizes} loading={loading} class="wf-layer" />
  </div>
  <div class="wf-pop">
    <Image src={iconCharacter} alt="" widths={[360, 640, 900]} sizes={sizes} loading={loading} class="wf-layer wf-character" />
  </div>
  <Image src={propStar} alt="" width={160} loading={loading} class="wf-prop wf-star" />
  <Image src={propCoin} alt="" width={160} loading={loading} class="wf-prop wf-coin" />
  <Image src={propPin} alt="" width={160} loading={loading} class="wf-prop wf-pin" />
</div>

<style>
  .wf-art {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    --tile-inset: 13%;
    --tile-radius: 22%;
  }
  .wf-tile,
  .wf-pop {
    position: absolute;
    inset: var(--tile-inset);
  }
  .wf-tile {
    overflow: hidden;
    border-radius: var(--tile-radius);
    box-shadow:
      0 2px 0 rgb(11 11 15 / 0.06),
      0 28px 50px -22px rgb(11 11 15 / 0.55);
    transition: transform 0.7s var(--ease-out);
  }
  /* The character shares the tile's box but may rise out of its top edge;
     its bottom corners are clipped to the tile's rounded corners. */
  .wf-pop {
    clip-path: inset(-40% 0 0 0 round 0 0 var(--tile-radius) var(--tile-radius));
    pointer-events: none;
  }
  .wf-layer {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wf-character {
    transform: translateY(-6%) scale(1.03);
    transform-origin: 50% 100%;
    transition: transform 0.7s var(--ease-out);
  }
  .wf-prop {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 12px 14px rgb(11 11 15 / 0.28));
    transition: transform 0.8s var(--spring);
  }
  .wf-star {
    width: 21%;
    right: 2%;
    top: 4%;
    transform: rotate(12deg);
  }
  .wf-coin {
    width: 22%;
    left: 1%;
    bottom: 6%;
    transform: rotate(-10deg);
  }
  .wf-pin {
    width: 17%;
    left: 3%;
    top: 14%;
    transform: rotate(-8deg);
  }

  /* Hover (from the art or any wrapping .art-hover): the explorer leans out
     and the props drift outwards. */
  :global(.art-hover:hover) .wf-character,
  .wf-art:hover .wf-character {
    transform: translateY(-11%) scale(1.06);
  }
  :global(.art-hover:hover) .wf-tile,
  .wf-art:hover .wf-tile {
    transform: scale(0.985);
  }
  :global(.art-hover:hover) .wf-star,
  .wf-art:hover .wf-star {
    transform: translate(8%, -10%) rotate(32deg) scale(1.08);
  }
  :global(.art-hover:hover) .wf-coin,
  .wf-art:hover .wf-coin {
    transform: translate(-10%, 6%) rotate(-28deg) scale(1.06);
  }
  :global(.art-hover:hover) .wf-pin,
  .wf-art:hover .wf-pin {
    transform: translate(-12%, -8%) rotate(-18deg);
  }

  /* One-time entrance: the tile settles, the explorer rises, props pop in. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion) .wf-tile {
      animation: wf-tile-in 0.9s var(--ease-out) 0.15s backwards;
    }
    :global(.motion) .wf-character {
      animation: wf-rise 1s var(--ease-out) 0.35s backwards;
    }
    :global(.motion) .wf-prop {
      animation: wf-pop 0.8s var(--spring) backwards;
    }
    :global(.motion) .wf-pin {
      animation-delay: 0.6s;
    }
    :global(.motion) .wf-star {
      animation-delay: 0.72s;
    }
    :global(.motion) .wf-coin {
      animation-delay: 0.84s;
    }
  }
  @keyframes wf-tile-in {
    from {
      opacity: 0;
      transform: translateY(8%) rotate(-4deg) scale(0.94);
    }
  }
  @keyframes wf-rise {
    from {
      transform: translateY(14%) scale(1.03);
    }
  }
  @keyframes wf-pop {
    from {
      opacity: 0;
      transform: scale(0.3) rotate(-40deg);
    }
  }
</style>
