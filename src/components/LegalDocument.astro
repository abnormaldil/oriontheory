---
import type { LegalDocument } from '~/data/legal';
import { legal } from '~/data/site';
import { inline } from '~/lib/inline';
import { stageStyle } from '~/lib/stage';

interface Props {
  doc: LegalDocument;
  /** Link to the companion document. */
  sibling: { href: string; label: string };
}
const { doc, sibling } = Astro.props;
const isDraft = !legal.reviewed;
---

<section class="stage-hero legal-head">
  <div class="wrap">
  <div class="stage" style={stageStyle('mist')}>
  <span class="stage-layer l1" aria-hidden="true"></span>
  <span class="stage-layer l2" aria-hidden="true"></span>
  <div class="stage-panel stage-copy">
    <h1 class="display t-5">{doc.title}</h1>
    <dl class="legal-intro">
      {
        doc.intro.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd set:html={inline(row.value)} />
          </div>
        ))
      }
    </dl>
  </div>
  </div>
  </div>
</section>

<div class="wrap legal-grid">
  <nav class="toc" aria-labelledby="toc-title">
    <h2 id="toc-title" class="toc-title">Contents</h2>
    <ol>
      {
        doc.sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`}>
              <span class="toc-num">{i + 1}.</span> {s.heading}
            </a>
          </li>
        ))
      }
    </ol>
    <p class="toc-sibling">
      See also: <a class="link" href={sibling.href}>{sibling.label}</a>
    </p>
  </nav>

  <div class="legal-body">
    {
      isDraft && (
        <aside class="draft-notice on-light" role="note" aria-labelledby="draft-title">
          <h2 id="draft-title" class="draft-title">Draft — pending publisher review</h2>
          <p>
            This document is a working draft and is not yet final. Highlighted
            <mark class="placeholder">[bracketed items]</mark> are details still being confirmed,
            and publisher notes describe what each section will cover.
          </p>
          <p class="draft-detail" set:html={inline(doc.draftNotice)} />
        </aside>
      )
    }

    {
      doc.sections.map((section, i) => (
        <section id={section.id} class="legal-section prose" aria-labelledby={`${section.id}-h`}>
          <h2 id={`${section.id}-h`}>
            <span class="sec-num">{i + 1}.</span> {section.heading}
          </h2>
          {section.blocks.map((block) => {
            if (block.type === 'p') return <p set:html={inline(block.text)} />;
            if (block.type === 'list')
              return (
                <ul>
                  {block.items.map((item) => (
                    <li set:html={inline(item)} />
                  ))}
                </ul>
              );
            return isDraft ? (
              <div class="publisher-note">
                <span class="note-label">Publisher note</span>
                <p set:html={inline(block.text)} />
              </div>
            ) : null;
          })}
        </section>
      ))
    }

    <p class="legal-end muted">
      Questions? Visit <a class="link" href="/contact">Contact</a> or
      <a class="link" href="/support">Support</a>.
    </p>
  </div>
</div>

<style>
  .legal-intro {
    display: grid;
    gap: 1rem;
    width: 100%;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1.5px solid var(--rule);
  }
  .legal-intro dt {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--fg-2);
  }
  .legal-intro dd {
    margin-top: 0.25rem;
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    .legal-intro {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }

  .legal-grid {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-5);
  }
  @media (min-width: 64rem) {
    .legal-grid {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: var(--space-5);
    }
    .toc {
      position: sticky;
      top: 6rem;
      align-self: start;
      max-height: calc(100vh - 7.5rem);
      overflow: auto;
    }
  }
  .toc {
    padding: 1.4rem 1.4rem 1.25rem;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .toc-title {
    font-family: var(--font-display);
    font-style: italic;
    font-stretch: 118%;
    font-weight: 800;
    font-size: var(--step-1);
  }
  .toc ol {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
  }
  .toc a {
    display: block;
    padding-block: 0.3rem;
    font-size: 0.93rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.3s var(--ease-out);
  }
  .toc a:hover {
    color: var(--link);
    transform: translateX(3px);
  }
  .toc-num {
    display: inline-block;
    min-width: 1.6rem;
    font-weight: 700;
    color: var(--link);
  }
  .toc-sibling {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.92rem;
  }

  .legal-body {
    max-width: 46rem;
  }
  .draft-notice {
    display: grid;
    gap: 0.75rem;
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius);
    background: var(--sun);
    margin-bottom: var(--space-4);
  }
  .draft-title {
    font-family: var(--font-display);
    font-style: italic;
    font-stretch: 118%;
    font-weight: 800;
    font-size: var(--step-1);
  }
  .draft-notice p {
    font-size: 0.95rem;
  }
  .draft-notice :global(mark.placeholder) {
    background: var(--paper);
  }
  .draft-detail {
    font-size: 0.88rem !important;
  }
  .legal-section {
    max-width: none;
    padding-top: var(--space-3);
  }
  .legal-section h2 {
    margin-top: 0;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .sec-num {
    color: var(--link);
  }
  .publisher-note {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1.05rem;
    border: 1.5px dashed var(--fg-3);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 0.93rem;
    color: var(--fg-2);
  }
  .note-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--fg);
  }
  .legal-end {
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 1.5px solid var(--rule);
  }
</style>
