---
import Logo from './Logo.astro';
import OrionMark from './OrionMark.astro';
import { footerNav, site } from '~/data/site';

interface Props {
  hideCallout?: boolean;
}
const { hideCallout = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', { 'has-callout': !hideCallout }]}>
  {
    !hideCallout && (
      <section class="callout" aria-labelledby="footer-callout-title">
        <div class="wrap">
          <div class="callout-panel band-tomato mark-hover" data-reveal>
            <h2 id="footer-callout-title" class="display t-4">
              Have a question or an idea?
            </h2>
            <div class="callout-body">
              <p class="lede">We’d like to hear from you.</p>
              <a class="btn" href="/contact">
                Contact Orion Theory <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
            <div class="callout-mark">
              <OrionMark />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <div class="footer-main band-ink">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label={`${site.name} — home`}>
          <Logo variant="lockup" tone="paper" />
        </a>
        <p>{site.tagline}</p>
      </div>
      <nav class="footer-col" aria-labelledby="footer-make">
        <h2 id="footer-make">Explore</h2>
        <ul>{footerNav.make.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-studio">
        <h2 id="footer-studio">Studio</h2>
        <ul>{footerNav.studio.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-legal">
        <h2 id="footer-legal">Legal</h2>
        <ul>{footerNav.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </div>

    <div class="wrap wordmark" data-reveal="wipe">
      <Logo variant="wordmark" tone="paper" alt="" />
    </div>

    <div class="wrap footer-base">
      <p>© {year} {site.name}</p>
      <p>Independent publisher of mobile games and apps</p>
    </div>
  </div>
</footer>

<style>
  /* The callout panel straddles the paper/ink edge, like a card laid on top. */
  .callout {
    background: linear-gradient(to bottom, transparent 50%, var(--raised) 50%);
    padding-top: var(--space-5);
  }
  .callout-panel {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: clamp(2rem, 1rem + 4vw, 4.5rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  .callout h2 {
    max-width: 12ch;
    position: relative;
    z-index: 1;
  }
  .callout-body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    align-content: end;
  }
  .callout-mark {
    position: absolute;
    right: -4%;
    bottom: -18%;
    width: clamp(10rem, 24vw, 22rem);
    color: rgb(11 11 15 / 0.14);
    pointer-events: none;
    transition: transform 0.9s var(--ease-out);
  }
  .callout-panel:hover .callout-mark {
    transform: rotate(-14deg);
  }
  @media (min-width: 58rem) {
    .callout-panel {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
    }
  }

  .footer-main {
    padding-top: var(--space-5);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr 1fr;
  }
  .footer-brand {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .footer-logo :global(.logo) {
    width: auto;
    height: 2.6rem;
  }
  .footer-brand p {
    font-family: var(--font-display);
    font-style: italic;
    font-stretch: 118%;
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.25;
    max-width: 19ch;
    color: rgb(255 255 255 / 0.86);
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
    .footer-brand {
      grid-column: auto;
    }
  }
  .footer-col h2 {
    margin-bottom: 0.75rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--sun);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }
  .footer-col a {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    background-image: linear-gradient(var(--tomato), var(--tomato));
    background-size: 0 2px;
    background-repeat: no-repeat;
    background-position: 0 88%;
    transition: background-size 0.4s var(--ease-out);
  }
  .footer-col a:hover {
    background-size: 100% 2px;
  }
  .footer-col :focus-visible,
  .footer-logo:focus-visible {
    outline-color: var(--sun);
  }

  /* The supplied wordmark, full width */
  .wordmark {
    margin-top: var(--space-5);
    user-select: none;
  }
  .wordmark :global(.logo) {
    width: 100%;
    height: auto;
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: var(--space-3);
    padding-block: 1.25rem 1.75rem;
    border-top: 1px solid var(--line-on-dark);
    font-size: var(--step--1);
    color: rgb(255 255 255 / 0.72);
  }
</style>
